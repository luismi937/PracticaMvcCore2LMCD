@model List<Libros>

    <h1>Libros</h1>

    <table>
        <thead>
            <tr>
                <th>Id Libro</th>
            </tr>
        <tr>
            <th>Titulo</th>
        </tr>
        <tr>
            <th>Autor</th>
        </tr>
        <tr>
            <th>Editorial</th>
        </tr>
        <tr>
            <th>Portada</th>
        </tr>
        <th>Precio</th>
        <th>Id Genero</th>
        <th>Detalles</th>
        </thead>
        <tbody>
          @foreach(Libros l in Model)
            {
            <a asp-controller="Libros" asp-action="Details" asp-route-idlibro="@l.IdLibro">
                <tr>
                <td>@l.IdLibro</td>
                <td>@l.Titulo</td>
                <td>@l.Autor</td>
                <td>@l.Editorial</td>
                <td><img src="~/images/@l.Portada" width="100px" /></td>
                <td>@l.Precio</td>
                <td>@l.IdGenero</td>
                <td>@Detalles</td>
                <td><a asp-controller="Libros" asp-action="Details" asp-route-idlibro="@l.IdLibro">Ver detalles</a>
                    </td>
            </tr>
            </a>
        }
        </tbody>
    </table>
